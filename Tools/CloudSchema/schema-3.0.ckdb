    RECORD TYPE CD_PantryItem (
        CD_barcode                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_barcode_ckAsset               ASSET,
        CD_categoryRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryRaw_ckAsset           ASSET,
        CD_didRestockExpired             INT64 QUERYABLE SORTABLE,
        CD_didRestockUsedUp              INT64 QUERYABLE SORTABLE,
        CD_entityName                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expirationDate                TIMESTAMP QUERYABLE SORTABLE,
        CD_expirationIsEstimated         INT64 QUERYABLE SORTABLE,
        CD_frozenDate                    TIMESTAMP QUERYABLE SORTABLE,
        CD_id                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ingredientOverride            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ingredientOverride_ckAsset    ASSET,
        CD_isLeftover                    INT64 QUERYABLE SORTABLE,
        CD_isUsedUp                      INT64 QUERYABLE SORTABLE,
        CD_lastCheckedDate               TIMESTAMP QUERYABLE SORTABLE,
        CD_locationRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_locationRaw_ckAsset           ASSET,
        CD_lowRestockSuggested           INT64 QUERYABLE SORTABLE,
        CD_moveReceipt                   BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset           ASSET,
        CD_name                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                  ASSET,
        CD_notes                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset                 ASSET,
        CD_openedDate                    TIMESTAMP QUERYABLE SORTABLE,
        CD_packageAmount                 DOUBLE QUERYABLE SORTABLE,
        CD_packageUnit                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_packageUnit_ckAsset           ASSET,
        CD_photo                         BYTES QUERYABLE SORTABLE,
        CD_photo_ckAsset                 ASSET,
        CD_price                         DOUBLE QUERYABLE SORTABLE,
        CD_purchaseDate                  TIMESTAMP QUERYABLE SORTABLE,
        CD_quantity                      DOUBLE QUERYABLE SORTABLE,
        CD_receipt                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_remainingAmount               DOUBLE QUERYABLE SORTABLE,
        CD_remainingFraction             DOUBLE QUERYABLE SORTABLE,
        CD_store                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_store_ckAsset                 ASSET,
        CD_unit                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unit_ckAsset                  ASSET,
        CD_unopenedExpiration            TIMESTAMP QUERYABLE SORTABLE,
        CD_unopenedExpirationIsEstimated INT64 QUERYABLE SORTABLE,
        CD_unopenedLocationRaw           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_unopenedLocationRaw_ckAsset   ASSET,
        CD_usedUpDate                    TIMESTAMP QUERYABLE SORTABLE,
        CD_wasTossed                     INT64 QUERYABLE SORTABLE,
        "___createTime"                  TIMESTAMP,
        "___createdBy"                   REFERENCE,
        "___etag"                        STRING,
        "___modTime"                     TIMESTAMP,
        "___modifiedBy"                  REFERENCE,
        "___recordID"                    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_Receipt (
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_image               BYTES QUERYABLE SORTABLE,
        CD_image_ckAsset       ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_rawText             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rawText_ckAsset     ASSET,
        CD_sourceID            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceID_ckAsset    ASSET,
        CD_store               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_store_ckAsset       ASSET,
        CD_total               DOUBLE QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
