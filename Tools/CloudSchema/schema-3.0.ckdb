DEFINE SCHEMA

    RECORD TYPE CD_BarBottle (
        CD_count               INT64 QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_format              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_format_ckAsset      ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_kindRaw_ckAsset     ASSET,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_name                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset        ASSET,
        CD_notes               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_notes_ckAsset       ASSET,
        CD_photo               BYTES QUERYABLE SORTABLE,
        CD_photo_ckAsset       ASSET,
        CD_region              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_region_ckAsset      ASSET,
        CD_style               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_style_ckAsset       ASSET,
        CD_vintage             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_vintage_ckAsset     ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_CookLog (
        CD_cost                DOUBLE QUERYABLE SORTABLE,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_neverAgain          INT64 QUERYABLE SORTABLE,
        CD_rating              INT64 QUERYABLE SORTABLE,
        CD_title               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset       ASSET,
        CD_wouldChange         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_wouldChange_ckAsset ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_KitchenEvent (
        CD_action              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_action_ckAsset      ASSET,
        CD_after               BYTES QUERYABLE SORTABLE,
        CD_after_ckAsset       ASSET,
        CD_before              BYTES QUERYABLE SORTABLE,
        CD_before_ckAsset      ASSET,
        CD_date                TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_explanation         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_explanation_ckAsset ASSET,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_itemID              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_operationID         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_undone              INT64 QUERYABLE SORTABLE,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_KitchenProfile (
        CD_allergies                  BYTES QUERYABLE SORTABLE,
        CD_allergies_ckAsset          ASSET,
        CD_allowExtraStore            INT64 QUERYABLE SORTABLE,
        CD_dietNotes                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_dietNotes_ckAsset          ASSET,
        CD_dislikes                   BYTES QUERYABLE SORTABLE,
        CD_dislikes_ckAsset           ASSET,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expirationWarningDays      INT64 QUERYABLE SORTABLE,
        CD_householdMemory            BYTES QUERYABLE SORTABLE,
        CD_householdMemory_ckAsset    ASSET,
        CD_householdSize              INT64 QUERYABLE SORTABLE,
        CD_ignoredFeedbackIDs         BYTES QUERYABLE SORTABLE,
        CD_ignoredFeedbackIDs_ckAsset ASSET,
        CD_leftoverPreference         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_leftoverPreference_ckAsset ASSET,
        CD_loves                      BYTES QUERYABLE SORTABLE,
        CD_loves_ckAsset              ASSET,
        CD_minimumExtraStoreSavings   DOUBLE QUERYABLE SORTABLE,
        CD_monthlyBudget              DOUBLE QUERYABLE SORTABLE,
        CD_moveReceipt                BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset        ASSET,
        CD_preferredBrands            BYTES QUERYABLE SORTABLE,
        CD_preferredBrands_ckAsset    ASSET,
        CD_preferredStore             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_preferredStore_ckAsset     ASSET,
        CD_skillLevel                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_skillLevel_ckAsset         ASSET,
        CD_spicePreference            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_spicePreference_ckAsset    ASSET,
        CD_weeknightMinutes           INT64 QUERYABLE SORTABLE,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MealPlanEntry (
        CD_day                 TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_ingredients         BYTES QUERYABLE SORTABLE,
        CD_ingredients_ckAsset ASSET,
        CD_isCooked            INT64 QUERYABLE SORTABLE,
        CD_minutes             INT64 QUERYABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_needToBuy           BYTES QUERYABLE SORTABLE,
        CD_needToBuy_ckAsset   ASSET,
        CD_servings            INT64 QUERYABLE SORTABLE,
        CD_steps               BYTES QUERYABLE SORTABLE,
        CD_steps_ckAsset       ASSET,
        CD_summary             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_summary_ckAsset     ASSET,
        CD_title               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset       ASSET,
