    RECORD TYPE CD_ShoppingItem (
        CD_categoryRaw            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_categoryRaw_ckAsset    ASSET,
        CD_createdAt              TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isChecked              INT64 QUERYABLE SORTABLE,
        CD_isDismissed            INT64 QUERYABLE SORTABLE,
        CD_isSpecificProduct      INT64 QUERYABLE SORTABLE,
        CD_mealNote               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_mealNote_ckAsset       ASSET,
        CD_moveReceipt            BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset    ASSET,
        CD_name                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset           ASSET,
        CD_planDemandKey          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_planDemandKey_ckAsset  ASSET,
        CD_planSourcesKey         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_planSourcesKey_ckAsset ASSET,
        CD_quantityNote           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_quantityNote_ckAsset   ASSET,
        CD_reason                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_reason_ckAsset         ASSET,
        CD_sourceItemID           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_wasAutoChecked         INT64 QUERYABLE SORTABLE,
